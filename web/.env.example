# --- Core ---
NEXT_PUBLIC_BRAND_NAME=LeadLine
# Public https URL of this site (Twilio and Stripe call back to it)
PUBLIC_BASE_URL=http://localhost:3000
# Long random string used to sign login sessions (openssl rand -hex 32)
SESSION_SECRET=
# Shared secret for the scheduler endpoint /api/cron/tick
CRON_SECRET=
# SQLite file location (defaults to ./data/app.db)
DATABASE_PATH=

# --- AI agent (Claude) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
AGENT_MODEL=

# --- Billing ($50/month plan in Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of a recurring $50/month price created in the Stripe dashboard
STRIPE_PRICE_ID=
# Local development only: "Subscribe" activates the account without Stripe
BILLING_DEV_BYPASS=false

# --- Phone calls and texts (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number you own, in E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=
TWILIO_VOICE=Polly.Joanna-Neural

# --- QuickBooks Online (overdue invoice import) ---
# From your app at developer.intuit.com → Keys & credentials. Add
# {PUBLIC_BASE_URL}/api/quickbooks/callback as a Redirect URI there.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox (Intuit test companies) or production (real customers)
QUICKBOOKS_ENVIRONMENT=sandbox
# Encrypts stored QuickBooks tokens. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
